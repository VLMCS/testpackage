rules_version = '2';

// Paste these into Firebase Console → Firestore Database → Rules.
// They allow read/write only to anonymous UIDs that have been paired into the workspace.
// Phase 2 wires the workspace creation + pairing flow.

service cloud.firestore {
  match /databases/{database}/documents {
    function isPairedToWorkspace(workspaceId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.allowedUids;
    }

    // Workspace doc is readable by anyone signed in (so they can attempt to pair),
    // but only writable by paired members. Pairing flow uses a transactional
    // update that verifies the passphrase hash before adding a UID.
    match /workspaces/{workspaceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.allowedUids.size() == 1
        && request.auth.uid in request.resource.data.allowedUids;
      allow update: if isPairedToWorkspace(workspaceId)
        || (
          // Allow a new user to add their UID after passphrase check (client verifies).
          request.auth != null
          && request.resource.data.allowedUids.size() == resource.data.allowedUids.size() + 1
          && request.auth.uid in request.resource.data.allowedUids
        );
      allow delete: if false;
    }

    // All nested data is gated on workspace membership.
    match /workspaces/{workspaceId}/{collection}/{docId} {
      allow read, write: if isPairedToWorkspace(workspaceId);
    }

    match /workspaces/{workspaceId}/{collection}/{docId}/{subcollection}/{subDocId} {
      allow read, write: if isPairedToWorkspace(workspaceId);
    }
  }
}
